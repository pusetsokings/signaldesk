# --- Dashboard operator auth (required in production) ---
# HTTP Basic Auth for the dashboard and every /api route except
# /api/cron/scan and /api/telegram/webhook. Without DASHBOARD_PASSWORD the
# deployed app returns 503 (fails closed); `next dev` stays open.
DASHBOARD_USER=operator
DASHBOARD_PASSWORD=

# --- Brandlytics CRM push (required for "Push to CRM") ---
BRANDLYTICS_CRM_WEBHOOK_URL=https://crm.brandlytics.agency/api/signals
BRANDLYTICS_CRM_API_KEY=

# --- Reddit connector (required for live scans) ---
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- AI engine providers (at least one required for AI scoring/drafting) ---
# Scan routing order: OpenAI -> Claude -> DeepSeek -> rule-based fallback.
# Override the first choice with ENGINE_PRIMARY=openai|anthropic|deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PERPLEXITY_API_KEY=
ENGINE_PRIMARY=

# --- TypeSafe triage (optional) ---
# When set, TypeSafe (Jev) scores intent/urgency and the LLM chain above only
# drafts replies for signals scoring >= TYPESAFE_DRAFT_MIN_SCORE (0-100).
TYPESAFE_API_KEY=
TYPESAFE_DRAFT_MIN_SCORE=40

# --- Urgent auto-action ---
# Scheduled/watchlist scans auto-approve and push to the CRM when a signal is
# AI-scored, not intent "none", has a draft, and meets both thresholds.
# Nothing is posted publicly. Set AUTO_ACTION_ENABLED=false to turn off.
AUTO_ACTION_ENABLED=true
AUTO_ACTION_MIN_URGENCY=80
AUTO_ACTION_MIN_INTENT=80

# --- Future connectors ---
YOUTUBE_API_KEY=
